---
import { site, contact, reseaux, navigation, marques } from '../data/site';
const annee = new Date().getFullYear();
---

<footer class="bg-marine text-white">
  <div class="mx-auto max-w-content px-5 py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Marques -->
      <div>
        <p class="font-serif text-xl font-bold">{marques.reno.nom}</p>
        <p class="text-sm text-white/70">{marques.reno.role}</p>
        <p class="mt-3 font-serif text-xl font-bold text-ocre-light">{marques.travaux.nom}</p>
        <p class="text-sm text-white/70">{marques.travaux.role}</p>
        <p class="mt-4 text-sm text-white/70">{site.experience} d’expérience tous corps d’état.</p>
      </div>

      <!-- Navigation -->
      <nav aria-label="Liens de pied de page">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-white/60">Navigation</p>
        <ul class="space-y-2">
          {navigation.map((item) => (
            <li>
              <a href={item.lien} class="text-sm text-white/80 hover:text-ocre-light">{item.libelle}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-white/60">Contact</p>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href={`tel:${contact.telephone}`} class="hover:text-ocre-light">{contact.telephoneAffiche}</a></li>
          <li><a href={`mailto:${contact.email}`} class="hover:text-ocre-light">{contact.email}</a></li>
          <li><a href={reseaux.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-light">WhatsApp</a></li>
        </ul>
        <p class="mt-4 text-sm text-white/70">{site.zones.join(' · ')}</p>
      </div>

      <!-- Réseaux sociaux -->
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-white/60">Suivez-nous</p>
        <ul class="space-y-2 text-sm text-white/80">
          <li><a href={reseaux.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-light">Instagram</a></li>
          <li><a href={reseaux.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-light">LinkedIn</a></li>
          <li><a href={reseaux.twitter} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-light">X (Twitter)</a></li>
          <li><a href={reseaux.whatsapp} target="_blank" rel="noopener noreferrer" class="hover:text-ocre-light">WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-white/15 pt-6 text-xs text-white/60 sm:flex-row sm:items-center sm:justify-between">
      <p>© {annee} {site.nom} — {marques.travaux.nom}. Tous droits réservés.</p>
      <p>Assistance à maîtrise d’ouvrage & entreprise générale de bâtiment — {contact.ville} et toute la France.</p>
    </div>
  </div>
</footer>
