---
// Bouton « Réserver un créneau ».
// La destination est lue depuis PUBLIC_BOOKING_URL (Calendly / Cal.com).
// Si la variable est vide, le bouton renvoie vers la page Contact.
interface Props {
  small?: boolean;
  label?: string;
  variant?: 'ocre' | 'marine' | 'blanc';
}
const { small = false, label = 'Réserver un créneau', variant = 'ocre' } = Astro.props;

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL || '/contact';
const external = bookingUrl.startsWith('http');

const variants = {
  ocre: 'bg-ocre text-white hover:bg-ocre-dark',
  marine: 'bg-marine text-white hover:bg-marine-light',
  blanc: 'bg-white text-marine hover:bg-brume',
};
---

<a
  href={bookingUrl}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    'inline-flex items-center justify-center rounded-full font-semibold transition-colors',
    variants[variant],
    small ? 'px-5 py-2 text-sm' : 'px-7 py-3.5',
  ]}
>
  {label}
</a>
